{
    "name": "spark-control-plane",
    "version": "0.1.0",
    "license": "Apache-2.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "npm run dev:web",
        "dev:web": "vite --configLoader runner --host 127.0.0.1",
        "demo:up": "docker compose --file compose.dev.yaml up --detach --build --wait && docker compose --file compose.dev.yaml port control-plane 8080",
        "demo:down": "docker compose --file compose.dev.yaml down",
        "build": "npm run build:web && npm run typecheck:server",
        "build:web": "npm run typecheck:web && vite build --configLoader runner",
        "lint": "eslint .",
        "start": "npm run start:server",
        "start:server": "node --experimental-strip-types src/server/runtime/standaloneServer.ts",
        "test": "npm run build && npm run test:unit && npm run test:contract && npm run test:integration",
        "test:coverage": "npm run build && npm run test:coverage:unit:server && npm run test:coverage:unit:web && npm run test:coverage:contract && npm run test:coverage:integration:base && npm run test:coverage:container:contract && npm run test:integration:stack",
        "test:coverage:unit:server": "node --test --test-concurrency=1 --experimental-strip-types --experimental-test-coverage \"tests/server/unit/**/*.test.ts\"",
        "test:coverage:unit:web": "node --test --test-concurrency=1 --experimental-strip-types --experimental-test-coverage \"tests/web/unit/**/*.test.ts\"",
        "test:coverage:contract": "node --test --test-concurrency=1 --experimental-strip-types --experimental-test-coverage \"tests/server/contract/**/*.test.ts\"",
        "test:coverage:integration:base": "node --test --test-concurrency=1 --experimental-strip-types --experimental-test-coverage tests/integration/*.test.ts",
        "test:coverage:container:contract": "node --test --test-concurrency=1 --experimental-strip-types --experimental-test-coverage tests/integration/container/containerContract.test.ts",
        "test:server": "npm run build && npm run test:unit:server && npm run test:contract && npm run test:integration:base && npm run test:integration:postgres",
        "test:unit": "npm run test:unit:server && npm run test:unit:web",
        "test:unit:server": "node --test --test-concurrency=1 --experimental-strip-types \"tests/server/unit/**/*.test.ts\"",
        "test:unit:web": "node --test --test-concurrency=1 --experimental-strip-types \"tests/web/unit/**/*.test.ts\"",
        "test:contract": "node --test --test-concurrency=1 --experimental-strip-types \"tests/server/contract/**/*.test.ts\"",
        "test:container": "npm run test:container:contract && npm run test:integration:container",
        "test:container:contract": "node --test --test-concurrency=1 --experimental-strip-types tests/integration/container/containerContract.test.ts",
        "test:integration": "npm run test:integration:base && npm run test:integration:stack",
        "test:integration:base": "node --test --test-concurrency=1 --experimental-strip-types tests/integration/*.test.ts",
        "test:integration:stack": "node tests/integration/run-integration-stack.mjs --suite all",
        "test:integration:container": "node tests/integration/run-integration-stack.mjs --suite container",
        "test:integration:postgres": "node tests/integration/run-integration-stack.mjs --suite postgres",
        "test:integration:polaris": "node tests/integration/run-integration-stack.mjs --suite polaris",
        "test:integration:spark": "node tests/integration/run-integration-stack.mjs --suite spark",
        "test:integration:upgrade": "node tests/integration/run-integration-stack.mjs --suite upgrade",
        "audit:production-dependencies": "node tests/security/audit-production-dependencies.mjs",
        "typecheck:web": "tsc -p tsconfig.web.json --pretty false",
        "typecheck:server": "tsc -p tsconfig.server.json --pretty false",
        "preview": "vite preview --configLoader runner --host 127.0.0.1"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.103.2",
        "js-yaml": "^4.3.2",
        "lucide-react": "^0.544.0",
        "pg": "^8.23.0",
        "react": "^19.1.1",
        "react-dom": "^19.1.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.36.0",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^24.5.2",
        "@types/pg": "^8.21.0",
        "@types/react": "^19.1.13",
        "@types/react-dom": "^19.1.9",
        "@vitejs/plugin-react": "^5.0.4",
        "eslint": "^9.36.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.20",
        "globals": "^16.4.0",
        "typescript": "~5.9.2",
        "typescript-eslint": "^8.44.1",
        "vite": "^7.1.7"
    }
}
